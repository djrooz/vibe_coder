# Токен бота от @BotFather
BOT_TOKEN=
# Строка подключения Neon Postgres. Пусто — встроенный PGlite (для локальной разработки)
DATABASE_URL=
# Пароль входа в CRM. Пусто — вход без пароля (только локально!)
ADMIN_PASSWORD=
# Секрет webhook (необязательно, по умолчанию выводится из BOT_TOKEN)
WEBHOOK_SECRET=
# Публичный URL сервиса. На Render задаётся автоматически (RENDER_EXTERNAL_URL)
PUBLIC_URL=
# 1 — получать апдейты через getUpdates вместо webhook (локально)
POLLING=
